<ui:FluentWindow x:Class="MonitorWindowControl.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:MonitorWindowControl"
                 Title="Monitor Window Control"
                 Width="1100" Height="780" MinWidth="520" MinHeight="480"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/app.ico">
    <!--
        Laid out like Windows 11 Settings: navigation on the left, one page at a time on the right, each setting a
        card with an icon, a title and description, and its control on the right. Narrow windows collapse the
        navigation to icons; on wide windows the Apps page shows the selected app's options beside the list.
    -->
    <ui:FluentWindow.Resources>
        <local:HideWhenTrueConverter x:Key="HideWhenTrue" />
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Monitor Window Control" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Grid Margin="8,0,4,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,6,0,18">
                    <Image Source="pack://application:,,,/app.ico" Width="40" Height="40" />
                    <StackPanel x:Name="NavIdentity" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Monitor Window Control" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock x:Name="NavStatus" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </StackPanel>
                <ui:ListView x:Name="NavList" Grid.Row="1" SelectionMode="Single" SelectionChanged="NavList_SelectionChanged"
                             AutomationProperties.Name="Pages">
                    <ui:ListViewItem Tag="General" AutomationProperties.Name="General">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                            <TextBlock Text="General" Margin="14,0,0,0" FontSize="14" />
                        </StackPanel>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="Monitors" AutomationProperties.Name="Monitors">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="18" />
                            <TextBlock Text="Monitors" Margin="14,0,0,0" FontSize="14" />
                        </StackPanel>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="Apps" AutomationProperties.Name="Apps">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="18" />
                            <TextBlock Text="Apps" Margin="14,0,0,0" FontSize="14" />
                        </StackPanel>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="About" AutomationProperties.Name="About">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Info24" FontSize="18" />
                            <TextBlock Text="About" Margin="14,0,0,0" FontSize="14" />
                        </StackPanel>
                    </ui:ListViewItem>
                </ui:ListView>
            </Grid>

            <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <!-- Content fills the width up to a comfortable maximum and stays next to the navigation, like Settings. -->
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1860" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                <Grid x:Name="Pages" Margin="24,4,32,28" RequestBringIntoView="Page_RequestBringIntoView">

                    <!-- ============================================================ General -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                        <TextBlock Style="{StaticResource Secondary}" FontSize="13" Margin="2,0,0,16"
                                   Text="Opens each app's windows on the monitor you actually use that app on. It learns that by itself, so there's nothing you have to set up." />

                        <!-- Shown while something outside the app pauses it (Remote Desktop, duplicated monitors) -->
                        <ui:InfoBar x:Name="PauseInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
                                    AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status" />

                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Power24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="How it runs" />
                                    <TextBlock x:Name="RunModeHint" Style="{StaticResource Secondary}" />
                                    <TextBlock x:Name="BackgroundStatusText" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="RunModeCombo" MinWidth="250" AutomationProperties.Name="How it runs" SelectionChanged="RunModeCombo_SelectionChanged">
                                <ComboBoxItem Content="In the tray (catches every window)" Tag="Tray" />
                                <ComboBoxItem Content="Small background helper (no tray icon)" Tag="Helper" />
                                <ComboBoxItem Content="Nothing in the background (shortcuts only)" Tag="LaunchOnly" />
                            </ComboBox>
                        </ui:CardControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Placing windows" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=WindowNew24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Move new windows" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Open each new window on its app's monitor. Turn off to pause everything." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="EnabledToggle" AutomationProperties.Name="Move new windows to their app's monitor" Click="EnabledToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Lightbulb24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Learn automatically" />
                                    <TextBlock x:Name="LearnHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="LearnToggle" AutomationProperties.Name="Learn automatically" Click="LearnToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Window24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Apps it hasn't learned yet" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Where windows of apps without a monitor open." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="UnknownCombo" MinWidth="250" AutomationProperties.Name="Apps it hasn't learned yet" SelectionChanged="UnknownCombo_SelectionChanged">
                                <ComboBoxItem Content="Open on main monitor" />
                                <ComboBoxItem Content="Leave where Windows puts them" />
                                <ComboBoxItem Content="Open on the monitor with the mouse pointer" />
                            </ComboBox>
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=SquareMultiple24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Open dialogs on the same monitor as their app" />
                                    <TextBlock x:Name="DialogsHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="DialogsToggle" AutomationProperties.Name="Open dialogs on the same monitor as their app" Click="DialogsToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Games24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Pause while a game or presentation is running" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="While a game or any other app runs fullscreen, or Windows is in presentation mode, windows aren't moved and nothing is learned. Windows that open meanwhile are placed when it ends, unless you've switched to them." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="GameToggle" AutomationProperties.Name="Pause while a game or presentation is running" Click="GameToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=DesktopArrowRight24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="While connected with Remote Desktop" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="When you use this PC from another one, the other PC's monitors replace these. Learning always pauses then." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="RemoteCombo" MinWidth="250" AutomationProperties.Name="While connected with Remote Desktop" SelectionChanged="RemoteCombo_SelectionChanged">
                                <ComboBoxItem Content="Pause" />
                                <ComboBoxItem Content="Keep moving windows" />
                            </ComboBox>
                        </ui:CardControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="When monitors change" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=DesktopArrowDown24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="When an app's monitor is off" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Where apps open while their own monitor is disconnected or switched off. You can choose something else for one app on the Apps page." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="FallbackCombo" MinWidth="250" AutomationProperties.Name="When an app's monitor is off, open it on" SelectionChanged="FallbackCombo_SelectionChanged" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=ArrowHookUpLeft24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="When a monitor comes back" />
                                    <TextBlock x:Name="ReturnHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="ReturnCombo" MinWidth="250" AutomationProperties.Name="When a monitor comes back" SelectionChanged="ReturnCombo_SelectionChanged">
                                <ComboBoxItem Content="Move its windows back" />
                                <ComboBoxItem Content="Leave them where they are" />
                            </ComboBox>
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=WeatherMoon24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Put windows back after sleep" />
                                    <TextBlock x:Name="SleepHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SleepToggle" AutomationProperties.Name="Put windows back after sleep" Click="SleepToggle_Click" />
                        </ui:CardControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Tidy up" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Broom24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Move open windows to their monitors" />
                                    <TextBlock x:Name="TidyHint" Style="{StaticResource Secondary}" />
                                    <CheckBox x:Name="TidyIncludeMoved" Content="Include windows I moved myself" Margin="0,6,0,0"
                                              AutomationProperties.Name="Include windows I moved myself" Click="TidyIncludeMoved_Click" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="TidyButton" Content="Move windows" MinWidth="140" Click="Tidy_Click"
                                       AutomationProperties.Name="Move open windows to their monitors" />
                        </ui:CardControl>

                        <!-- Keyboard shortcuts (off by default; they need something running in the background) -->
                        <StackPanel x:Name="HotKeysSection">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Keyboard shortcuts" />
                            <ui:CardControl Icon="{ui:SymbolIcon Symbol=Keyboard24}">
                                <ui:CardControl.Header>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Keyboard shortcuts" />
                                        <TextBlock x:Name="HotKeysHint" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="HotKeysToggle" AutomationProperties.Name="Keyboard shortcuts" Click="HotKeysToggle_Click" />
                            </ui:CardControl>
                            <ui:CardExpander x:Name="HotKeysExpander" Icon="{ui:SymbolIcon Symbol=KeyboardShift24}" Margin="0,0,0,4"
                                             AutomationProperties.Name="Change the keys">
                                <ui:CardExpander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Change the keys" />
                                        <TextBlock Style="{StaticResource Secondary}" Text="Hold Shift too, and that monitor also becomes the app's monitor from now on." />
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <StackPanel x:Name="HotKeyRows" KeyboardNavigation.TabNavigation="Continue" />
                            </ui:CardExpander>
                        </StackPanel>

                        <!-- Notifications from the tray icon (all off by default) -->
                        <StackPanel x:Name="NoticesSection">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Notifications" />
                            <ui:CardExpander Icon="{ui:SymbolIcon Symbol=Alert24}" AutomationProperties.Name="Notifications">
                                <ui:CardExpander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Notifications" />
                                        <TextBlock x:Name="NoticesHint" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <StackPanel>
                                    <CheckBox x:Name="NoticeLearnedBox" Tag="Learned" Click="Notice_Click" Margin="0,0,0,4"
                                              Content="When it learns a new monitor for an app" />
                                    <CheckBox x:Name="NoticeElsewhereBox" Tag="OpenedElsewhere" Click="Notice_Click" Margin="0,0,0,4"
                                              Content="When an app opens on another monitor because its own is off" />
                                    <CheckBox x:Name="NoticeBackBox" Tag="MonitorBack" Click="Notice_Click" Margin="0,0,0,4"
                                              Content="When a monitor comes back and its windows move back" />
                                    <CheckBox x:Name="NoticeAdminBox" Tag="AdminApp" Click="Notice_Click" Margin="0,0,0,4"
                                              Content="When it can't move an app that runs as administrator" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                               Text="At most one notification a day for each app. Select a notification to undo what it says." />
                                </StackPanel>
                            </ui:CardExpander>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Startup" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Rocket24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Start with Windows" />
                                    <TextBlock x:Name="StartupHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="StartupToggle" AutomationProperties.Name="Start with Windows" Click="StartupToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=PersonClock24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Also place apps that opened while signing in" />
                                    <TextBlock x:Name="SignInHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SignInToggle" AutomationProperties.Name="Also place apps that opened while signing in" Click="SignInToggle_Click" />
                        </ui:CardControl>

                        <StackPanel x:Name="RecentPanel" Margin="0,22,0,0">
                            <TextBlock Style="{StaticResource SectionHeader}" Margin="2,0,0,8" Text="Recent activity" />
                            <ui:Card Padding="8,4">
                                <ItemsControl x:Name="RecentList" AutomationProperties.Name="Recent activity" KeyboardNavigation.TabNavigation="Continue">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" VerticalAlignment="Top" Margin="0,1,12,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" Content="Undo" Appearance="Transparent" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Click="Undo_Click" Visibility="{Binding CanUndo, Converter={StaticResource ShowWhenTrue}}"
                                                           AutomationProperties.Name="{Binding UndoName}" ToolTip="{Binding UndoName}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:Card>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============================================================ Monitors -->
                    <StackPanel x:Name="PageMonitors" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Monitors" />
                        <TextBlock Style="{StaticResource Secondary}" FontSize="13" Margin="2,0,0,16"
                                   Text="Give your monitors your own names and numbers, and choose the main monitor (where the taskbar clock and Start menu are, and where apps it hasn't learned yet open)." />
                        <ItemsControl x:Name="MonitorsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Desktop24}">
                                            <ui:CardControl.Header>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Label}" />
                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Details}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="Move its windows" Margin="0,0,8,0" Click="MoveMonitorWindows_Click"
                                                           Visibility="{Binding HasOtherMonitors, Converter={StaticResource ShowWhenTrue}}"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Move the windows on {0} to another monitor'}"
                                                           ToolTip="Move the windows on this monitor to another monitor, once" />
                                                <ui:Button Content="Name &amp; number" Click="RenameMonitor_Click"
                                                           Visibility="{Binding CanRename, Converter={StaticResource ShowWhenTrue}}"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Name and number for {0}'}"
                                                           ToolTip="Give this monitor your own name and number, for example &quot;2 · TV&quot;" />
                                                <ui:Button Content="Make main" Margin="8,0,0,0" Click="MakeMain_Click"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Make {0} the main monitor'}"
                                                           Visibility="{Binding IsPrimary, Converter={StaticResource HideWhenTrue}}"
                                                           ToolTip="Make this the main monitor in Windows (taskbar clock, Start menu, and where new apps open)" />
                                            </StackPanel>
                                        </ui:CardControl>
                                        <!-- Wireless, virtual and USB monitors: are they temporary? -->
                                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Cast24}" Margin="40,0,0,4"
                                                        Visibility="{Binding ShowTemporaryOption, Converter={StaticResource ShowWhenTrue}}">
                                            <ui:CardControl.Header>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="Apps can open here" />
                                                    <TextBlock Style="{StaticResource Secondary}"
                                                               Text="Turn off for a monitor you only connect now and then, like a wireless one. Apps then aren't learned on it, and it isn't used when another monitor is off. Apps you set to open here still do." />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding AppsCanOpenHere, Mode=OneWay}" Click="AppsCanOpenHere_Click"
                                                             AutomationProperties.Name="{Binding Name, StringFormat='Apps can open on {0}'}" />
                                        </ui:CardControl>
                                        <!-- A TV that stays connected when it's turned off with its remote -->
                                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=DesktopOff24}" Margin="40,0,0,4"
                                                        Visibility="{Binding ShowMonitorChoices, Converter={StaticResource ShowWhenTrue}}">
                                            <ui:CardControl.Header>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="Treat as switched off" />
                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding SwitchedOffNote}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ComboBox MinWidth="200" SelectedIndex="{Binding SwitchedOffIndex, Mode=OneWay}"
                                                      SelectionChanged="SwitchedOff_SelectionChanged" PreviewMouseWheel="Combo_PreviewMouseWheel"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Treat {0} as switched off'}">
                                                <ComboBoxItem Content="No" />
                                                <ComboBoxItem Content="Until I turn it back on" />
                                                <ComboBoxItem Content="For 1 hour" />
                                            </ComboBox>
                                        </ui:CardControl>
                                        <!-- Keep a monitor (a TV) for a few chosen apps -->
                                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=LockClosed24}" Margin="40,0,0,4"
                                                        Visibility="{Binding ShowMonitorChoices, Converter={StaticResource ShowWhenTrue}}">
                                            <ui:CardControl.Header>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="What can open here" />
                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding OpenHereNote}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ComboBox MinWidth="200" SelectedIndex="{Binding OpenHereIndex, Mode=OneWay}"
                                                      SelectionChanged="OpenHere_SelectionChanged" PreviewMouseWheel="Combo_PreviewMouseWheel"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='What can open on {0}'}">
                                                <ComboBoxItem Content="Any app" />
                                                <ComboBoxItem Content="Only apps I choose" />
                                            </ComboBox>
                                        </ui:CardControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:CardControl x:Name="KeepMainCard" Icon="{ui:SymbolIcon Symbol=DesktopCheckmark24}" Margin="0,12,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Keep my main monitor" />
                                    <TextBlock x:Name="KeepMainHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="KeepMainToggle" AutomationProperties.Name="Keep my main monitor" Click="KeepMainToggle_Click" />
                        </ui:CardControl>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Related settings" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=LinkSquare24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Display" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Arrange monitors, resolution, scale and HDR in Windows Settings. Windows keeps its own display numbers there." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Open" Click="OpenDisplaySettings_Click" AutomationProperties.Name="Open Windows display settings" />
                        </ui:CardControl>
                    </StackPanel>

                    <!-- ============================================================ Apps -->
                    <StackPanel x:Name="PageApps" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Apps" />
                        <TextBlock x:Name="ListTip" Style="{StaticResource Secondary}" FontSize="13" Margin="2,0,0,16"
                                   Text="You don't need to set anything here: just use your apps, and each one is learned after a few seconds on a monitor. Select an app only if you want to choose its monitor yourself." />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search apps" TextChanged="SearchBox_TextChanged"
                                        AutomationProperties.Name="Search apps" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" />
                            <ui:Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                       Click="RefreshApps_Click" ToolTip="Update the list of open apps now" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        </Grid>

                        <Grid x:Name="AppsLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="DetailColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                            <ui:Card Padding="0" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Margin="16,10,16,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*" /><ColumnDefinition Width="5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="App" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Opens on" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <ui:ListView x:Name="AppsList" MinHeight="120" Margin="4,0,4,4" SelectionMode="Single"
                                                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Apps and where they open"
                                                     KeyDown="AppsList_KeyDown"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     RequestBringIntoView="AppsList_RequestBringIntoView"
                                                     SelectionChanged="AppsList_SelectionChanged">
                                            <ui:ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="5*" /><ColumnDefinition Width="5*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <DockPanel>
                                                                <!-- A tip for an app that keeps moving itself back (see Advanced) -->
                                                                <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Info16" FontSize="14" Margin="6,0,0,0"
                                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                               ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Hint}"
                                                                               Visibility="{Binding HasHint, Converter={StaticResource ShowWhenTrue}}" />
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" ToolTip="{Binding OpensOn}">
                                                            <TextBlock Text="{Binding OpensOn}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Source}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ui:ListView.ItemTemplate>
                                        </ui:ListView>
                                        <TextBlock x:Name="EmptyText" Style="{StaticResource Secondary}" Margin="20,16" FontSize="13" />
                                    </Grid>
                                </Grid>
                            </ui:Card>

                            <!-- Selected app: beside the list when wide, below it when narrow -->
                            <StackPanel x:Name="DetailPane" Grid.Row="1" Margin="0,8,0,0">
                                <ui:Card x:Name="SelectionPanel" Padding="16,14" IsEnabled="False">
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedAppName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="No app selected" />
                                        <TextBlock x:Name="SelectedAppDetail" Style="{StaticResource Secondary}" Margin="0,2,0,12" />
                                        <TextBlock Text="Open it on" Margin="0,0,0,6" />
                                        <ComboBox x:Name="TargetCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Open it on" SelectionChanged="TargetCombo_SelectionChanged" />
                                        <!-- An app that's open now: move its windows there once, without saving -->
                                        <ui:Button x:Name="MoveNowButton" Content="Move its windows there now" Margin="0,8,0,0" Visibility="Collapsed"
                                                   Icon="{ui:SymbolIcon ArrowMove24}" Click="MoveNow_Click"
                                                   AutomationProperties.Name="Move its open windows to the chosen monitor now, without saving"
                                                   ToolTip="Moves its open windows once. Where it opens next time only changes when you press Save." />
                                        <!-- Only for "Where I used it last": which monitors the app may open on -->
                                        <StackPanel x:Name="AllowedPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="AllowedIntro" Style="{StaticResource Secondary}" FontSize="13" />
                                            <ItemsControl x:Name="AllowedList" Margin="0,6,0,0" KeyboardNavigation.TabNavigation="Continue" />
                                            <TextBlock x:Name="LastUsedLaunchOnlyNote" Style="{StaticResource Secondary}" Margin="0,4,0,0" Visibility="Collapsed"
                                                       Text="Note: with nothing running in the background, Monitor Window Control can't see where you use the app, so it opens where it was used when you last changed this." />
                                        </StackPanel>
                                        <!-- Where it opens while its monitor is off or disconnected -->
                                        <StackPanel x:Name="AppFallbackPanel" Margin="0,12,0,0">
                                            <TextBlock Text="If it's off, open on" Margin="0,0,0,6" />
                                            <ComboBox x:Name="AppFallbackCombo" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="If its monitor is off, open it on" />
                                        </StackPanel>
                                        <!-- Where on the monitor its window goes -->
                                        <StackPanel x:Name="PlacePanel" Margin="0,12,0,0">
                                            <TextBlock Text="Place it" Margin="0,0,0,6" />
                                            <ComboBox x:Name="PlaceCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Place it"
                                                      SelectionChanged="PlaceCombo_SelectionChanged">
                                                <ComboBoxItem Content="Centered" />
                                                <ComboBoxItem Content="Where I last had it" />
                                                <ComboBoxItem Content="Maximized" />
                                            </ComboBox>
                                            <DockPanel x:Name="PlaceLastPanel" Margin="0,4,0,0" Visibility="Collapsed">
                                                <ui:Button x:Name="ResetPlaceButton" DockPanel.Dock="Right" Content="Reset" Appearance="Transparent"
                                                           Margin="8,0,0,0" VerticalAlignment="Top" Click="ResetPlace_Click"
                                                           AutomationProperties.Name="Reset: forget where it was on each monitor"
                                                           ToolTip="Forget where it was on each monitor" />
                                                <TextBlock x:Name="PlaceLastNote" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>
                                        <!-- Advanced: timing for apps that show a splash screen or move themselves after opening -->
                                        <ui:CardExpander x:Name="AdvancedExpander" Margin="0,12,0,0" Icon="{ui:SymbolIcon Symbol=Timer24}"
                                                         AutomationProperties.Name="Advanced">
                                            <ui:CardExpander.Header>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="Advanced" />
                                                    <TextBlock Style="{StaticResource Secondary}" Text="For an app that opens a splash screen first, or moves itself back after it's moved." />
                                                </StackPanel>
                                            </ui:CardExpander.Header>
                                            <StackPanel>
                                                <TextBlock x:Name="AdvancedTip" Style="{StaticResource Secondary}" FontSize="13" Margin="0,0,0,10"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed"
                                                           Text="This app moved itself back twice after it was moved. Try a longer wait before moving." />
                                                <TextBlock Text="Wait before moving" Margin="0,0,0,6" />
                                                <ComboBox x:Name="WaitCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Wait before moving">
                                                    <ComboBoxItem Content="Automatic" />
                                                    <ComboBoxItem Content="1 second" />
                                                    <ComboBoxItem Content="3 seconds" />
                                                </ComboBox>
                                                <TextBlock Text="Keep correcting for" Margin="0,12,0,6" />
                                                <ComboBox x:Name="CorrectCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Keep correcting for">
                                                    <ComboBoxItem Content="1 second" />
                                                    <ComboBoxItem Content="5 seconds" />
                                                </ComboBox>
                                                <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                                           Text="If the app moves its window back to where it opened during this time, it's moved again (at most 3 times). After that it's always left where it is." />
                                            </StackPanel>
                                        </ui:CardExpander>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <ui:Button Content="Save" Appearance="Primary" MinWidth="96" Click="ChangeMonitor_Click" />
                                            <ui:Button x:Name="ForgetButton" Content="Forget" Margin="8,0,0,0" Click="Forget_Click"
                                                       AutomationProperties.Name="Forget this app" ToolTip="Forget this app's monitor (Delete key)" />
                                        </StackPanel>
                                        <!-- Launch shortcut (the way to use "nothing in the background"; works in every mode) -->
                                        <Separator Margin="0,14,0,10" />
                                        <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <ui:Button x:Name="ShortcutButton" Content="Create launch shortcut" Click="Shortcut_Click" Icon="{ui:SymbolIcon Pin24}" />
                                    </StackPanel>
                                </ui:Card>
                                <TextBlock Style="{StaticResource Secondary}" Margin="2,8,0,0"
                                           Text="Select an app, choose where it opens, and press Save. Its open windows move there right away, and learning won't change your choice." />
                            </StackPanel>
                        </Grid>

                        <ui:Button x:Name="ForgetAllButton" Content="Forget all apps…" Margin="0,16,0,0" Click="ForgetAll_Click" Icon="{ui:SymbolIcon Delete24}" />
                    </StackPanel>

                    <!-- ============================================================ About -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="About" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Info24}" Margin="0,10,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Monitor Window Control" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Project page" Click="OpenProject_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=DocumentText24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Activity log" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Every window it moved, every app it learned, and every change you made, with the time." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Open" Click="OpenLog_Click" AutomationProperties.Name="Open activity log" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Folder24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Settings folder" />
                                    <TextBlock x:Name="SettingsFolderText" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Open" Click="OpenFolder_Click" AutomationProperties.Name="Open settings folder" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Shield24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Privacy" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Collects nothing and never connects to the internet. Everything stays on this PC." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Privacy statement" Click="OpenPrivacy_Click" />
                        </ui:CardControl>
                        <ui:CardControl x:Name="ExitCard" Icon="{ui:SymbolIcon Symbol=SignOut24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Exit" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Close Monitor Window Control completely. New windows aren't placed until you open it again." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="ExitButton" Content="Exit" Click="Exit_Click" />
                        </ui:CardControl>
                    </StackPanel>
                </Grid>
              </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
