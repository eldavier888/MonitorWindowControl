<ui:FluentWindow x:Class="MonitorWindowControl.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:MonitorWindowControl"
                 Title="Monitor Window Control"
                 Width="1100" Height="780" MinWidth="520" MinHeight="480"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontSize="{DynamicResource TextBodyLarge}"
                 Icon="pack://application:,,,/app.ico">
    <!--
        Laid out like Windows 11 Settings: navigation on the left, one page at a time on the right, each setting a
        card with an icon, a title and description, and its control on the right. Narrow windows collapse the
        navigation to icons; on wide windows the Apps page shows the selected app's options beside the list.
    -->
    <ui:FluentWindow.Resources>
        <local:HideWhenTrueConverter x:Key="HideWhenTrue" />
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TextTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TextBodyLarge}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource TextCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TextBodyLarge}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A clear keyboard focus rectangle around cards (in contrast themes it takes the theme's text colour) -->
        <Style x:Key="CardFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="7" RadiusY="7" StrokeThickness="2" SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocusVisual}" />
        </Style>
        <Style TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocusVisual}" />
        </Style>
        <!-- A monitor in the layout picture (a radio button or check box drawn as a tile, like Settings > Display) -->
        <Style x:Key="MonitorTile" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TileBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="4" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Monitor Window Control" />

        <Grid x:Name="MainArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Grid Margin="8,0,4,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="10,6,0,18">
                    <Image Source="pack://application:,,,/app.ico" Width="40" Height="40" VerticalAlignment="Top" AutomationProperties.Name="Monitor Window Control" />
                    <StackPanel x:Name="NavIdentity" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Monitor Window Control" FontWeight="SemiBold" FontSize="{DynamicResource TextBodyLarge}" TextWrapping="Wrap" />
                        <TextBlock x:Name="NavStatus" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </DockPanel>
                <ui:ListView x:Name="NavList" Grid.Row="1" SelectionMode="Single" SelectionChanged="NavList_SelectionChanged"
                             AutomationProperties.Name="Pages">
                    <ui:ListViewItem Tag="General" AutomationProperties.Name="General">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                            <TextBlock Text="General" Margin="14,0,0,0" FontSize="{DynamicResource TextBodyLarge}" />
                        </StackPanel>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="Monitors" AutomationProperties.Name="Monitors">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="18" />
                            <TextBlock Text="Monitors" Margin="14,0,0,0" FontSize="{DynamicResource TextBodyLarge}" />
                        </StackPanel>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="Apps" AutomationProperties.Name="Apps">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="18" />
                            <TextBlock Text="Apps" Margin="14,0,0,0" FontSize="{DynamicResource TextBodyLarge}" />
                        </StackPanel>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="About" AutomationProperties.Name="About">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Info24" FontSize="18" />
                            <TextBlock Text="About" Margin="14,0,0,0" FontSize="{DynamicResource TextBodyLarge}" />
                        </StackPanel>
                    </ui:ListViewItem>
                </ui:ListView>
            </Grid>

            <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <!-- Content fills the width up to a comfortable maximum and stays next to the navigation, like Settings. -->
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1860" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                <Grid x:Name="Pages" Margin="24,4,32,28" RequestBringIntoView="Page_RequestBringIntoView">

                    <!-- ============================================================ General -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                        <TextBlock Style="{StaticResource Secondary}" FontSize="{DynamicResource TextBody}" Margin="2,0,0,16"
                                   Text="Opens each app's windows on the monitor you actually use that app on. It learns that by itself, so there's nothing you have to set up." />

                        <!-- Shown while something outside the app pauses it (Remote Desktop, duplicated monitors) -->
                        <ui:InfoBar x:Name="PauseInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
                                    AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status" />
                        <!-- Settings your organization manages are locked (Windows Settings shows the same bar) -->
                        <ui:InfoBar x:Name="PolicyInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
                                    Title="Some settings are managed by your organization"
                                    AutomationProperties.Name="Some settings are managed by your organization" />
                        <!-- Helper mode, but the helper isn't running (it crashed, or something stopped it) -->
                        <StackPanel x:Name="HelperDownPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <ui:InfoBar x:Name="HelperDownBar" IsOpen="True" IsClosable="False" Severity="Warning"
                                        Title="The background helper isn't running"
                                        Message="New windows aren't moved to their monitors and nothing is learned until it runs again."
                                        AutomationProperties.LiveSetting="Assertive"
                                        AutomationProperties.Name="The background helper isn't running" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button Content="Start it" Appearance="Primary" Click="StartHelper_Click"
                                           AutomationProperties.Name="Start the background helper" />
                                <ui:Button x:Name="HelperReportButton" Content="View report" Margin="8,0,0,0" Click="OpenCrashReport_Click"
                                           AutomationProperties.Name="View the crash report" />
                            </StackPanel>
                        </StackPanel>
                        <!-- After a crash: say so once, with the local report -->
                        <StackPanel x:Name="CrashPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <ui:InfoBar x:Name="CrashBar" IsOpen="True" IsClosable="False" Severity="Warning"
                                        Message="A report was saved on this PC. Nothing was sent anywhere. If it keeps happening, you can share the report when you report the problem."
                                        AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button Content="Open report" Click="OpenCrashReport_Click" AutomationProperties.Name="Open the crash report" />
                                <ui:Button Content="Copy" Margin="8,0,0,0" Click="CopyCrashReport_Click" AutomationProperties.Name="Copy the crash report" />
                                <ui:Button Content="Dismiss" Margin="8,0,0,0" Appearance="Transparent" Click="DismissCrash_Click"
                                           AutomationProperties.Name="Dismiss the crash message" />
                            </StackPanel>
                        </StackPanel>

                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Power24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="How it runs" />
                                    <TextBlock x:Name="RunModeHint" Style="{StaticResource Secondary}" />
                                    <TextBlock x:Name="BackgroundStatusText" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="RunModeCombo" MinWidth="250" AutomationProperties.Name="How it runs" SelectionChanged="RunModeCombo_SelectionChanged">
                                <ComboBoxItem Content="In the tray (catches every window)" Tag="Tray" />
                                <ComboBoxItem Content="Small background helper (no tray icon)" Tag="Helper" />
                                <ComboBoxItem Content="Nothing in the background (shortcuts only)" Tag="LaunchOnly" />
                            </ComboBox>
                        </ui:CardControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Placing windows" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=WindowNew24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Move new windows" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Open each new window on its app's monitor. Turn off to pause everything." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="EnabledToggle" AutomationProperties.Name="Move new windows to their app's monitor" Click="EnabledToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Lightbulb24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Learn automatically" />
                                    <TextBlock x:Name="LearnHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="LearnToggle" AutomationProperties.Name="Learn automatically" Click="LearnToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Window24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Apps it hasn't learned yet" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Where windows of apps without a monitor open." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="UnknownCombo" MinWidth="250" AutomationProperties.Name="Apps it hasn't learned yet" SelectionChanged="UnknownCombo_SelectionChanged">
                                <ComboBoxItem Content="Open on main monitor" />
                                <ComboBoxItem Content="Leave where Windows puts them" />
                                <ComboBoxItem Content="Open on the monitor with the mouse pointer" />
                            </ComboBox>
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=SquareMultiple24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Open dialogs on the same monitor as their app" />
                                    <TextBlock x:Name="DialogsHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="DialogsToggle" AutomationProperties.Name="Open dialogs on the same monitor as their app" Click="DialogsToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Games24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Pause while a game or presentation is running" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="While a game or any other app runs fullscreen, or Windows is in presentation mode, windows aren't moved and nothing is learned. Windows that open meanwhile are placed when it ends, unless you've switched to them." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="GameToggle" AutomationProperties.Name="Pause while a game or presentation is running" Click="GameToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=DesktopArrowRight24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="While connected with Remote Desktop" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="When you use this PC from another one, the other PC's monitors replace these. Learning always pauses then." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="RemoteCombo" MinWidth="250" AutomationProperties.Name="While connected with Remote Desktop" SelectionChanged="RemoteCombo_SelectionChanged">
                                <ComboBoxItem Content="Pause" />
                                <ComboBoxItem Content="Keep moving windows" />
                            </ComboBox>
                        </ui:CardControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="When monitors change" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=DesktopArrowDown24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="When an app's monitor is off" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Where apps open while their own monitor is disconnected or switched off. You can choose something else for one app on the Apps page." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="FallbackCombo" MinWidth="250" AutomationProperties.Name="When an app's monitor is off, open it on" SelectionChanged="FallbackCombo_SelectionChanged" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=ArrowHookUpLeft24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="When a monitor comes back" />
                                    <TextBlock x:Name="ReturnHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="ReturnCombo" MinWidth="250" AutomationProperties.Name="When a monitor comes back" SelectionChanged="ReturnCombo_SelectionChanged">
                                <ComboBoxItem Content="Move its windows back" />
                                <ComboBoxItem Content="Leave them where they are" />
                            </ComboBox>
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=WeatherMoon24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Put windows back after sleep" />
                                    <TextBlock x:Name="SleepHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SleepToggle" AutomationProperties.Name="Put windows back after sleep" Click="SleepToggle_Click" />
                        </ui:CardControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Tidy up" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Broom24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Move open windows to their monitors" />
                                    <TextBlock x:Name="TidyHint" Style="{StaticResource Secondary}" />
                                    <CheckBox x:Name="TidyIncludeMoved" Content="Include windows I moved myself" Margin="0,6,0,0"
                                              AutomationProperties.Name="Include windows I moved myself" Click="TidyIncludeMoved_Click" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="TidyButton" Content="Move windows" MinWidth="140" Click="Tidy_Click"
                                       AutomationProperties.Name="Move open windows to their monitors" />
                        </ui:CardControl>

                        <!-- Keyboard shortcuts (off by default; they need something running in the background) -->
                        <StackPanel x:Name="HotKeysSection">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Keyboard shortcuts" />
                            <ui:CardControl Icon="{ui:SymbolIcon Symbol=Keyboard24}">
                                <ui:CardControl.Header>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Keyboard shortcuts" />
                                        <TextBlock x:Name="HotKeysHint" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="HotKeysToggle" AutomationProperties.Name="Keyboard shortcuts" Click="HotKeysToggle_Click" />
                            </ui:CardControl>
                            <ui:CardExpander x:Name="HotKeysExpander" Icon="{ui:SymbolIcon Symbol=KeyboardShift24}" Margin="0,0,0,4"
                                             AutomationProperties.Name="Change the keys">
                                <ui:CardExpander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Change the keys" />
                                        <TextBlock Style="{StaticResource Secondary}" Text="Hold Shift too, and that monitor also becomes the app's monitor from now on." />
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <StackPanel x:Name="HotKeyRows" KeyboardNavigation.TabNavigation="Continue" />
                            </ui:CardExpander>
                        </StackPanel>

                        <!-- Notifications from the tray icon (all off by default) -->
                        <StackPanel x:Name="NoticesSection">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Notifications" />
                            <ui:CardExpander Icon="{ui:SymbolIcon Symbol=Alert24}" AutomationProperties.Name="Notifications">
                                <ui:CardExpander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Notifications" />
                                        <TextBlock x:Name="NoticesHint" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <StackPanel>
                                    <CheckBox x:Name="NoticeLearnedBox" Tag="Learned" Click="Notice_Click" Margin="0,0,0,4"
                                              Content="When it learns a new monitor for an app" AutomationProperties.Name="Notify when it learns a new monitor for an app" />
                                    <CheckBox x:Name="NoticeElsewhereBox" Tag="OpenedElsewhere" Click="Notice_Click" Margin="0,0,0,4"
                                              Content="When an app opens on another monitor because its own is off" AutomationProperties.Name="Notify when an app opens on another monitor because its own is off" />
                                    <CheckBox x:Name="NoticeBackBox" Tag="MonitorBack" Click="Notice_Click" Margin="0,0,0,4"
                                              Content="When a monitor comes back and its windows move back" AutomationProperties.Name="Notify when a monitor comes back and its windows move back" />
                                    <CheckBox x:Name="NoticeAdminBox" Tag="AdminApp" Click="Notice_Click" Margin="0,0,0,4"
                                              Content="When it can't move an app that runs as administrator" AutomationProperties.Name="Notify when it can't move an app that runs as administrator" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                               Text="At most one notification a day for each app. Select a notification to undo what it says." />
                                </StackPanel>
                            </ui:CardExpander>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Startup" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Rocket24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Start with Windows" />
                                    <TextBlock x:Name="StartupHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="StartupToggle" AutomationProperties.Name="Start with Windows" Click="StartupToggle_Click" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=PersonClock24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Also place apps that opened while signing in" />
                                    <TextBlock x:Name="SignInHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SignInToggle" AutomationProperties.Name="Also place apps that opened while signing in" Click="SignInToggle_Click" />
                        </ui:CardControl>

                        <StackPanel x:Name="RecentPanel" Margin="0,22,0,0">
                            <TextBlock Style="{StaticResource SectionHeader}" Margin="2,0,0,8" Text="Recent activity" />
                            <ui:Card Padding="8,4">
                                <ItemsControl x:Name="RecentList" AutomationProperties.Name="Recent activity" KeyboardNavigation.TabNavigation="Continue">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" VerticalAlignment="Top" Margin="0,1,12,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" Content="Undo" Appearance="Transparent" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Click="Undo_Click" Visibility="{Binding CanUndo, Converter={StaticResource ShowWhenTrue}}"
                                                           AutomationProperties.Name="{Binding UndoName}" ToolTip="{Binding UndoName}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:Card>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============================================================ Monitors -->
                    <StackPanel x:Name="PageMonitors" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Monitors" />
                        <TextBlock Style="{StaticResource Secondary}" FontSize="{DynamicResource TextBody}" Margin="2,0,0,16"
                                   Text="Give your monitors your own names and numbers, and choose the main monitor (where the taskbar clock and Start menu are, and where apps it hasn't learned yet open)." />
                        <ui:InfoBar x:Name="PolicyMonitorsBar" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
                                    Title="Some settings are managed by your organization"
                                    Message="Your organization doesn't allow changing the main monitor, so Make main and Keep my main monitor are turned off."
                                    AutomationProperties.Name="Some settings are managed by your organization" />
                        <!-- How the monitors are arranged; select one to go to its settings -->
                        <ui:Card Padding="16,14" Margin="0,0,0,4">
                            <StackPanel>
                                <local:MonitorLayoutView x:Name="MonitorLayout" MaxDiagramHeight="200" Margin="0,0,0,12"
                                                         AutomationProperties.Name="Monitor layout: select a monitor to go to its settings" />
                                <DockPanel>
                                    <ui:Button x:Name="IdentifyButton" DockPanel.Dock="Right" Content="Identify" Icon="{ui:SymbolIcon NumberSymbolSquare24}"
                                               Click="Identify_Click" AutomationProperties.Name="Identify: show each monitor's number and name on it for 3 seconds"
                                               ToolTip="Show each monitor's number and name on it for 3 seconds" />
                                    <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Text="Select a monitor to go to its settings. These are your own names and numbers, not the ones Windows uses." />
                                </DockPanel>
                            </StackPanel>
                        </ui:Card>
                        <ItemsControl x:Name="MonitorsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Desktop24}" MouseEnter="MonitorCard_MouseEnter" MouseLeave="MonitorCard_MouseLeave"
                                                        IsKeyboardFocusWithinChanged="MonitorCard_FocusWithinChanged">
                                            <ui:CardControl.Header>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Label}" />
                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Details}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="Move its windows" Margin="0,0,8,0" Click="MoveMonitorWindows_Click"
                                                           Visibility="{Binding HasOtherMonitors, Converter={StaticResource ShowWhenTrue}}"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Move the windows on {0} to another monitor'}"
                                                           ToolTip="Move the windows on this monitor to another monitor, once" />
                                                <ui:Button Content="Name &amp; number" Click="RenameMonitor_Click"
                                                           Visibility="{Binding CanRename, Converter={StaticResource ShowWhenTrue}}"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Name and number for {0}'}"
                                                           ToolTip="Give this monitor your own name and number, for example &quot;2 · TV&quot;" />
                                                <ui:Button Content="Make main" Margin="8,0,0,0" Click="MakeMain_Click" IsEnabled="{Binding CanMakeMain}"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Make {0} the main monitor'}"
                                                           Visibility="{Binding IsPrimary, Converter={StaticResource HideWhenTrue}}"
                                                           ToolTip="Make this the main monitor in Windows (taskbar clock, Start menu, and where new apps open)" />
                                                <ui:Button Content="Disconnect" Margin="8,0,0,0" Click="DisconnectMonitor_Click"
                                                           Icon="{ui:SymbolIcon PlugDisconnected24}"
                                                           Visibility="{Binding CanDisconnect, Converter={StaticResource ShowWhenTrue}}"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Disconnect {0} from Windows'}"
                                                           ToolTip="Windows stops using this monitor until you connect it again, like Disconnect this display in Windows Settings. It stays plugged in." />
                                            </StackPanel>
                                        </ui:CardControl>
                                        <!-- Wireless, virtual and USB monitors: are they temporary? -->
                                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Cast24}" Margin="40,0,0,4"
                                                        Visibility="{Binding ShowTemporaryOption, Converter={StaticResource ShowWhenTrue}}">
                                            <ui:CardControl.Header>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="Apps can open here" />
                                                    <TextBlock Style="{StaticResource Secondary}"
                                                               Text="Turn off for a monitor you only connect now and then, like a wireless one. Apps then aren't learned on it, and it isn't used when another monitor is off. Apps you set to open here still do." />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding AppsCanOpenHere, Mode=OneWay}" Click="AppsCanOpenHere_Click"
                                                             AutomationProperties.Name="{Binding Name, StringFormat='Apps can open on {0}'}" />
                                        </ui:CardControl>
                                        <!-- A TV that stays connected when it's turned off with its remote -->
                                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=DesktopOff24}" Margin="40,0,0,4"
                                                        Visibility="{Binding ShowMonitorChoices, Converter={StaticResource ShowWhenTrue}}">
                                            <ui:CardControl.Header>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="Treat as switched off" />
                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding SwitchedOffNote}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ComboBox MinWidth="200" SelectedIndex="{Binding SwitchedOffIndex, Mode=OneWay}"
                                                      SelectionChanged="SwitchedOff_SelectionChanged" PreviewMouseWheel="Combo_PreviewMouseWheel"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Treat {0} as switched off'}">
                                                <ComboBoxItem Content="No" />
                                                <ComboBoxItem Content="Until I turn it back on" />
                                                <ComboBoxItem Content="For 1 hour" />
                                            </ComboBox>
                                        </ui:CardControl>
                                        <!-- Keep a monitor (a TV) for a few chosen apps -->
                                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=LockClosed24}" Margin="40,0,0,4"
                                                        Visibility="{Binding ShowMonitorChoices, Converter={StaticResource ShowWhenTrue}}">
                                            <ui:CardControl.Header>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="What can open here" />
                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding OpenHereNote}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ComboBox MinWidth="200" SelectedIndex="{Binding OpenHereIndex, Mode=OneWay}"
                                                      SelectionChanged="OpenHere_SelectionChanged" PreviewMouseWheel="Combo_PreviewMouseWheel"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='What can open on {0}'}">
                                                <ComboBoxItem Content="Any app" />
                                                <ComboBoxItem Content="Only apps I choose" />
                                            </ComboBox>
                                        </ui:CardControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Plugged in, but disconnected from Windows (here or in Windows Settings) -->
                        <ItemsControl x:Name="DisconnectedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Icon="{ui:SymbolIcon Symbol=PlugDisconnected24}" Margin="0,0,0,4">
                                        <ui:CardControl.Header>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Secondary}" Text="Disconnected from Windows. It's plugged in, but Windows doesn't use it." />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="Connect" Click="ConnectMonitor_Click" Icon="{ui:SymbolIcon PlugConnected24}"
                                                   AutomationProperties.Name="{Binding Name, StringFormat='Connect {0} to Windows again'}" />
                                    </ui:CardControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:CardControl x:Name="KeepMainCard" Icon="{ui:SymbolIcon Symbol=DesktopCheckmark24}" Margin="0,12,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Keep my main monitor" />
                                    <TextBlock x:Name="KeepMainHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="KeepMainToggle" AutomationProperties.Name="Keep my main monitor" Click="KeepMainToggle_Click" />
                        </ui:CardControl>
                        <!-- Your setups: shown once a second set of monitors has been seen -->
                        <StackPanel x:Name="SetupsSection" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Your setups" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,8" TextWrapping="Wrap"
                                       Text="Each set of monitors you use is remembered. With your usual monitors, apps open where you chose. With other monitors, an app can open somewhere else: choose its monitor on the Apps page while those monitors are connected, or just use it there." />
                            <ItemsControl x:Name="SetupsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=DesktopFlow24}" Margin="0,0,0,4">
                                            <ui:CardControl.Header>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="Rename" Click="RenameSetup_Click"
                                                           AutomationProperties.Name="{Binding Title, StringFormat='Rename the setup {0}'}" />
                                                <ui:Button Content="Forget" Margin="8,0,0,0" Click="ForgetSetup_Click"
                                                           Visibility="{Binding CanForget, Converter={StaticResource ShowWhenTrue}}"
                                                           AutomationProperties.Name="{Binding Title, StringFormat='Forget the setup {0}'}"
                                                           ToolTip="Forget this setup and where apps open with it" />
                                            </StackPanel>
                                        </ui:CardControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Related settings" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=LinkSquare24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Display" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Arrange monitors, resolution, scale and HDR in Windows Settings. Windows keeps its own display numbers there." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Open" Click="OpenDisplaySettings_Click" AutomationProperties.Name="Open Windows display settings" />
                        </ui:CardControl>
                    </StackPanel>

                    <!-- ============================================================ Apps -->
                    <StackPanel x:Name="PageApps" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Apps" />
                        <TextBlock x:Name="ListTip" Style="{StaticResource Secondary}" FontSize="{DynamicResource TextBody}" Margin="2,0,0,16"
                                   Text="You don't need to set anything here: just use your apps, and each one is learned after a few seconds on a monitor. Select an app only if you want to choose its monitor yourself." />
                        <ui:InfoBar x:Name="PolicyAppsBar" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
                                    Title="Some settings are managed by your organization"
                                    Message="Where some apps open is set by your organization. Those apps say so in the list, and you can't change or forget them."
                                    AutomationProperties.Name="Some settings are managed by your organization" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search apps" TextChanged="SearchBox_TextChanged"
                                        AutomationProperties.Name="Search apps" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" />
                            <ui:Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                       Click="RefreshApps_Click" ToolTip="Update the list of open apps now" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       AutomationProperties.Name="Update the list of open apps now" />
                        </Grid>

                        <Grid x:Name="AppsLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="DetailColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                            <ui:Card Padding="0" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Margin="16,10,16,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*" /><ColumnDefinition Width="5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="App" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Opens on" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <ui:ListView x:Name="AppsList" MinHeight="120" Margin="4,0,4,4" SelectionMode="Single"
                                                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Apps and where they open"
                                                     KeyDown="AppsList_KeyDown"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     RequestBringIntoView="AppsList_RequestBringIntoView"
                                                     SelectionChanged="AppsList_SelectionChanged">
                                            <ui:ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="5*" /><ColumnDefinition Width="5*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="{Binding Indent}">
                                                            <DockPanel>
                                                                <!-- A tip for an app that keeps moving itself back (see Advanced) -->
                                                                <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Info16" FontSize="14" Margin="6,0,0,0"
                                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                               ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Hint}"
                                                                               Visibility="{Binding HasHint, Converter={StaticResource ShowWhenTrue}}" />
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" ToolTip="{Binding OpensOn}">
                                                            <TextBlock Text="{Binding OpensOn}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Source}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" />
                                                            <!-- This app opens somewhere else with another set of monitors -->
                                                            <Border HorizontalAlignment="Left" Margin="0,3,0,0" Padding="6,1" CornerRadius="4"
                                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                                    Visibility="{Binding HasChip, Converter={StaticResource ShowWhenTrue}}">
                                                                <TextBlock Text="{Binding Chip}" FontSize="{DynamicResource TextCaption}" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ui:ListView.ItemTemplate>
                                        </ui:ListView>
                                        <TextBlock x:Name="EmptyText" Style="{StaticResource Secondary}" Margin="20,16" FontSize="{DynamicResource TextBody}" />
                                    </Grid>
                                </Grid>
                            </ui:Card>

                            <!-- Selected app: beside the list when wide, below it when narrow -->
                            <StackPanel x:Name="DetailPane" Grid.Row="1" Margin="0,8,0,0">
                                <ui:Card x:Name="SelectionPanel" Padding="16,14" IsEnabled="False">
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedAppName" FontSize="{DynamicResource TextSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap" Text="No app selected" />
                                        <TextBlock x:Name="SelectedAppDetail" Style="{StaticResource Secondary}" Margin="0,2,0,12" />
                                        <TextBlock Text="Open it on" Margin="0,0,0,6" />
                                        <!-- The same choice as a picture: select a monitor (or, for "Where I used it last", tick several) -->
                                        <local:MonitorLayoutView x:Name="TargetLayout" MaxDiagramHeight="90" Margin="0,0,0,8"
                                                                 AutomationProperties.Name="Open it on: monitor layout" />
                                        <local:MonitorLayoutView x:Name="AllowedLayout" MultiSelect="True" MaxDiagramHeight="90" Margin="0,0,0,8" Visibility="Collapsed"
                                                                 AutomationProperties.Name="Monitors it may open on: monitor layout" />
                                        <ComboBox x:Name="TargetCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Open it on" SelectionChanged="TargetCombo_SelectionChanged" />
                                        <TextBlock x:Name="AppPolicyNote" Style="{StaticResource Secondary}" Margin="0,4,0,0" Visibility="Collapsed"
                                                   Text="Where this app opens is set by your organization." />
                                        <TextBlock x:Name="SetupNote" Style="{StaticResource Secondary}" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                        <!-- An app that's open now: move its windows there once, without saving -->
                                        <ui:Button x:Name="MoveNowButton" Content="Move its windows there now" Margin="0,8,0,0" Visibility="Collapsed"
                                                   Icon="{ui:SymbolIcon ArrowMove24}" Click="MoveNow_Click"
                                                   AutomationProperties.Name="Move its open windows to the chosen monitor now, without saving"
                                                   ToolTip="Moves its open windows once. Where it opens next time only changes when you press Save." />
                                        <!-- Only for "Where I used it last": which monitors the app may open on -->
                                        <StackPanel x:Name="AllowedPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="AllowedIntro" Style="{StaticResource Secondary}" FontSize="{DynamicResource TextBody}" />
                                            <ItemsControl x:Name="AllowedList" Margin="0,6,0,0" KeyboardNavigation.TabNavigation="Continue" />
                                            <TextBlock x:Name="LastUsedLaunchOnlyNote" Style="{StaticResource Secondary}" Margin="0,4,0,0" Visibility="Collapsed"
                                                       Text="Note: with nothing running in the background, Monitor Window Control can't see where you use the app, so it opens where it was used when you last changed this." />
                                        </StackPanel>
                                        <!-- Where it opens while its monitor is off or disconnected -->
                                        <StackPanel x:Name="AppFallbackPanel" Margin="0,12,0,0">
                                            <TextBlock Text="If it's off, open on" Margin="0,0,0,6" />
                                            <ComboBox x:Name="AppFallbackCombo" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="If its monitor is off, open it on" />
                                        </StackPanel>
                                        <!-- Where on the monitor its window goes -->
                                        <StackPanel x:Name="PlacePanel" Margin="0,12,0,0">
                                            <TextBlock Text="Place it" Margin="0,0,0,6" />
                                            <ComboBox x:Name="PlaceCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Place it"
                                                      SelectionChanged="PlaceCombo_SelectionChanged">
                                                <ComboBoxItem Content="Centered" />
                                                <ComboBoxItem Content="Where I last had it" />
                                                <ComboBoxItem Content="Maximized" />
                                            </ComboBox>
                                            <DockPanel x:Name="PlaceLastPanel" Margin="0,4,0,0" Visibility="Collapsed">
                                                <ui:Button x:Name="ResetPlaceButton" DockPanel.Dock="Right" Content="Reset" Appearance="Transparent"
                                                           Margin="8,0,0,0" VerticalAlignment="Top" Click="ResetPlace_Click"
                                                           AutomationProperties.Name="Reset: forget where it was on each monitor"
                                                           ToolTip="Forget where it was on each monitor" />
                                                <TextBlock x:Name="PlaceLastNote" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>
                                        <!-- Advanced: timing for apps that show a splash screen or move themselves after opening -->
                                        <ui:CardExpander x:Name="AdvancedExpander" Margin="0,12,0,0" Icon="{ui:SymbolIcon Symbol=Timer24}"
                                                         AutomationProperties.Name="Advanced">
                                            <ui:CardExpander.Header>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="Advanced" />
                                                    <TextBlock Style="{StaticResource Secondary}" Text="For an app that opens a splash screen first, or moves itself back after it's moved." />
                                                </StackPanel>
                                            </ui:CardExpander.Header>
                                            <StackPanel>
                                                <TextBlock x:Name="AdvancedTip" Style="{StaticResource Secondary}" FontSize="{DynamicResource TextBody}" Margin="0,0,0,10"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed"
                                                           Text="This app moved itself back twice after it was moved. Try a longer wait before moving." />
                                                <TextBlock Text="Wait before moving" Margin="0,0,0,6" />
                                                <ComboBox x:Name="WaitCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Wait before moving">
                                                    <ComboBoxItem Content="Automatic" />
                                                    <ComboBoxItem Content="1 second" />
                                                    <ComboBoxItem Content="3 seconds" />
                                                </ComboBox>
                                                <TextBlock Text="Keep correcting for" Margin="0,12,0,6" />
                                                <ComboBox x:Name="CorrectCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Keep correcting for">
                                                    <ComboBoxItem Content="1 second" />
                                                    <ComboBoxItem Content="5 seconds" />
                                                </ComboBox>
                                                <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                                           Text="If the app moves its window back to where it opened during this time, it's moved again (at most 3 times). After that it's always left where it is." />
                                            </StackPanel>
                                        </ui:CardExpander>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <ui:Button Content="Save" Appearance="Primary" MinWidth="96" Click="ChangeMonitor_Click"
                                                       AutomationProperties.Name="Save where this app opens" />
                                            <ui:Button x:Name="ForgetButton" Content="Forget" Margin="8,0,0,0" Click="Forget_Click"
                                                       AutomationProperties.Name="Forget this app" ToolTip="Forget this app's monitor (Delete key)" />
                                        </StackPanel>
                                        <!-- Rules for some of its windows (a browser profile, a meeting window…) -->
                                        <Separator Margin="0,14,0,10" />
                                        <TextBlock Text="Rules for some of its windows" Margin="0,0,0,2" />
                                        <TextBlock x:Name="WindowRulesHint" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <ItemsControl x:Name="WindowRulesList" KeyboardNavigation.TabNavigation="Continue">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <ui:Button DockPanel.Dock="Right" Content="Remove" Appearance="Transparent" Margin="8,0,0,0"
                                                                   Click="RemoveWindowRule_Click" VerticalAlignment="Center"
                                                                   AutomationProperties.Name="{Binding Text, StringFormat='Remove the rule: {0}'}" />
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ui:Button x:Name="AddWindowRuleButton" Content="Add a rule for some of its windows…" Click="AddWindowRule_Click"
                                                   Icon="{ui:SymbolIcon WindowNew24}" Margin="0,2,0,0"
                                                   AutomationProperties.Name="Add a rule for some of its windows" />
                                        <!-- Launch shortcuts (the way to use "nothing in the background"; works in every mode) -->
                                        <Separator Margin="0,14,0,10" />
                                        <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Secondary}" FontSize="{DynamicResource TextBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <ItemsControl x:Name="ShortcutsList" KeyboardNavigation.TabNavigation="Continue">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <ui:Button DockPanel.Dock="Right" Content="Remove" Appearance="Transparent" Margin="8,0,0,0"
                                                                   Click="RemoveShortcut_Click" VerticalAlignment="Center"
                                                                   AutomationProperties.Name="{Binding File, StringFormat='Remove the shortcut {0}'}" />
                                                        <TextBlock Text="{Binding File}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ui:Button x:Name="ShortcutButton" Content="Create launch shortcut…" Click="Shortcut_Click" Icon="{ui:SymbolIcon Pin24}"
                                                   AutomationProperties.Name="Create a launch shortcut" />
                                    </StackPanel>
                                </ui:Card>
                                <TextBlock Style="{StaticResource Secondary}" Margin="2,8,0,0"
                                           Text="Select an app, choose where it opens, and press Save. Its open windows move there right away, and learning won't change your choice." />
                            </StackPanel>
                        </Grid>

                        <ui:Button x:Name="ForgetAllButton" Content="Forget all apps…" Margin="0,16,0,0" Click="ForgetAll_Click" Icon="{ui:SymbolIcon Delete24}"
                                   AutomationProperties.Name="Forget all apps" />

                        <!-- App groups: open a set of apps together, each on its monitor -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="App groups" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,8" TextWrapping="Wrap"
                                   Text="Open several apps at once, each on its monitor: for example a streaming app on the TV and a chat app on the side monitor. Groups don't close apps." />
                        <ItemsControl x:Name="GroupsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Icon="{ui:SymbolIcon Symbol=Apps24}" Margin="0,0,0,4">
                                        <ui:CardControl.Header>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Open" Appearance="Primary" Click="OpenGroup_Click" IsEnabled="{Binding CanOpen}"
                                                       AutomationProperties.Name="{Binding Name, StringFormat='Open the group {0}'}" />
                                            <ui:Button Content="{Binding ShortcutText}" Margin="8,0,0,0" Click="GroupShortcut_Click"
                                                       AutomationProperties.Name="{Binding ShortcutName}" />
                                            <ui:Button Content="Edit" Margin="8,0,0,0" Click="EditGroup_Click"
                                                       AutomationProperties.Name="{Binding Name, StringFormat='Edit the group {0}'}" />
                                            <ui:Button Content="Delete" Margin="8,0,0,0" Click="DeleteGroup_Click"
                                                       AutomationProperties.Name="{Binding Name, StringFormat='Delete the group {0}'}" />
                                        </StackPanel>
                                    </ui:CardControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button x:Name="NewGroupButton" Content="New group…" Margin="0,4,0,0" Click="NewGroup_Click" Icon="{ui:SymbolIcon Add24}"
                                   AutomationProperties.Name="New app group" />
                    </StackPanel>

                    <!-- ============================================================ About -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="About" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Info24}" Margin="0,10,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Monitor Window Control" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Project page" Click="OpenProject_Click" AutomationProperties.Name="Open the project page" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=DocumentText24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Activity log" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Every window it moved, every app it learned, and every change you made, with the time." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Open" Click="OpenLog_Click" AutomationProperties.Name="Open activity log" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Folder24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Settings folder" />
                                    <TextBlock x:Name="SettingsFolderText" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Open" Click="OpenFolder_Click" AutomationProperties.Name="Open settings folder" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Shield24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Privacy" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Collects nothing and never connects to the internet. Everything stays on this PC." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Privacy statement" Click="OpenPrivacy_Click" AutomationProperties.Name="Open the privacy statement" />
                        </ui:CardControl>

                        <!-- Backup: export, import and the automatic daily copies -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Backup" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=ArrowExportUp24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Export settings" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Save your apps, monitor names and settings to a file, for a new PC or to keep them safe." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Export…" Click="ExportSettings_Click" AutomationProperties.Name="Export settings" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=ArrowImport24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Import settings" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Use settings you exported before, on this PC or another one. You see what's in the file first, and choose to replace or add to your settings." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Import…" Click="ImportSettings_Click" AutomationProperties.Name="Import settings" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=History24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Restore a backup" />
                                    <TextBlock x:Name="BackupHint" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="BackupCombo" MinWidth="180" AutomationProperties.Name="Backup to restore" PreviewMouseWheel="Combo_PreviewMouseWheel" />
                                <ui:Button x:Name="RestoreButton" Content="Restore…" Margin="8,0,0,0" Click="RestoreBackup_Click"
                                           AutomationProperties.Name="Restore the selected backup" />
                            </StackPanel>
                        </ui:CardControl>

                        <!-- Troubleshooting -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Troubleshooting" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Stethoscope24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Save diagnostics" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Save the activity log, your settings, your monitor setup and any crash reports in one .zip file, to share when you report a problem. You see what's in it first. Nothing is sent." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Save…" Click="SaveDiagnostics_Click" AutomationProperties.Name="Save diagnostics" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Delete24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Remove from this PC" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Stop Monitor Window Control and remove it, its helper and its shortcuts. You can keep your settings for later. It's also listed in Settings → Apps → Installed apps." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Remove…" Click="RemoveFromPc_Click" AutomationProperties.Name="Remove from this PC" />
                        </ui:CardControl>
                        <ui:CardControl x:Name="ExitCard" Icon="{ui:SymbolIcon Symbol=SignOut24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Exit" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Close Monitor Window Control completely. New windows aren't placed until you open it again." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="ExitButton" Content="Exit" Click="Exit_Click" AutomationProperties.Name="Exit Monitor Window Control" />
                        </ui:CardControl>
                    </StackPanel>
                </Grid>
              </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ First-run welcome (3 steps, each can be skipped) -->
        <Grid x:Name="WelcomeOverlay" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource ApplicationBackgroundBrush}"
              AutomationProperties.Name="Welcome">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer x:Name="WelcomeScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="820" Margin="32,4,32,16">
                    <TextBlock x:Name="WelcomeStepText" Style="{StaticResource Secondary}" FontSize="{DynamicResource TextBody}" Margin="2,0,0,4" />
                    <TextBlock x:Name="WelcomeTitle" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="WelcomeIntro" Style="{StaticResource Secondary}" FontSize="{DynamicResource TextBody}" Margin="2,0,0,16" />

                    <!-- Step 1: your monitors -->
                    <StackPanel x:Name="WelcomeStep1">
                        <ui:Card Padding="16,14" Margin="0,0,0,4">
                            <StackPanel>
                                <local:MonitorLayoutView x:Name="WelcomeLayout" MaxDiagramHeight="170" Margin="0,0,0,12"
                                                         AutomationProperties.Name="Monitor layout" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Identify" Icon="{ui:SymbolIcon NumberSymbolSquare24}" Click="Identify_Click"
                                               AutomationProperties.Name="Identify: show each monitor's number and name on it for 3 seconds" />
                                    <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Text="Not sure which is which? Select Identify to show each monitor's number and name on it." />
                                </DockPanel>
                            </StackPanel>
                        </ui:Card>
                        <StackPanel x:Name="WelcomeMonitorRows" KeyboardNavigation.TabNavigation="Continue" />
                    </StackPanel>

                    <!-- Step 2: apps that belong on a specific monitor -->
                    <StackPanel x:Name="WelcomeStep2" Visibility="Collapsed">
                        <StackPanel x:Name="WelcomeAppRows" KeyboardNavigation.TabNavigation="Continue" />
                        <TextBlock x:Name="WelcomeNoApps" Style="{StaticResource Secondary}" FontSize="{DynamicResource TextBody}" Margin="2,0,0,8" Visibility="Collapsed"
                                   Text="No apps are open right now. That's fine: just use your apps, and each one is learned after a few seconds on a monitor." />
                        <StackPanel x:Name="WelcomeOnlyChosenSection">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Monitors for a few apps only" />
                            <StackPanel x:Name="WelcomeOnlyChosenRows" KeyboardNavigation.TabNavigation="Continue" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 3: how it runs -->
                    <StackPanel x:Name="WelcomeStep3" Visibility="Collapsed">
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Apps24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="In the tray (recommended)" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Places every new window and learns where you use apps. Its icon in the tray gives you quick choices. Uses about 30 MB of memory." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <RadioButton x:Name="WelcomeModeTray" GroupName="WelcomeMode" Tag="Tray" MinWidth="0"
                                         AutomationProperties.Name="In the tray (recommended). Uses about 30 MB of memory" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Sparkle24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Small background helper" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Does the same, with no tray icon. Open this window from the Start menu to change settings. Uses about 5 MB of memory." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <RadioButton x:Name="WelcomeModeHelper" GroupName="WelcomeMode" Tag="Helper" MinWidth="0"
                                         AutomationProperties.Name="Small background helper. Uses about 5 MB of memory" />
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Pin24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Nothing in the background" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Uses no memory while you work. Only apps you open from launch shortcuts (made on the Apps page) are placed, and nothing is learned." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <RadioButton x:Name="WelcomeModeLaunchOnly" GroupName="WelcomeMode" Tag="LaunchOnly" MinWidth="0"
                                         AutomationProperties.Name="Nothing in the background. Uses no memory while you work" />
                        </ui:CardControl>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Startup" />
                        <ui:CardControl Icon="{ui:SymbolIcon Symbol=Rocket24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Start with Windows" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Starts quietly when you sign in, so windows are placed from the start. Not needed with nothing in the background." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="WelcomeStartupToggle" AutomationProperties.Name="Start with Windows" />
                        </ui:CardControl>
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,12,0,0"
                                   Text="You can change all of this later on the General, Monitors and Apps pages." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="32,12,32,16">
                <DockPanel MaxWidth="820">
                    <ui:Button x:Name="WelcomeSkipButton" DockPanel.Dock="Left" Content="Skip" Appearance="Transparent" Click="WelcomeSkip_Click"
                               AutomationProperties.Name="Skip this step" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="WelcomeBackButton" Content="Back" MinWidth="96" Click="WelcomeBack_Click" AutomationProperties.Name="Back" />
                        <ui:Button x:Name="WelcomeNextButton" Content="Next" MinWidth="96" Margin="8,0,0,0" Appearance="Primary" Click="WelcomeNext_Click"
                                   AutomationProperties.Name="Next" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
