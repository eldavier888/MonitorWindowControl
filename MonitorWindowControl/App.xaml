<Application x:Class="MonitorWindowControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- Text sizes: changed to follow Settings → Accessibility → Text size (see ThemeSupport). -->
            <sys:Double x:Key="TextCaption">12</sys:Double>
            <sys:Double x:Key="TextBody">13</sys:Double>
            <sys:Double x:Key="TextBodyLarge">14</sys:Double>
            <sys:Double x:Key="TextSubtitle">16</sys:Double>
            <sys:Double x:Key="TextTitle">28</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
