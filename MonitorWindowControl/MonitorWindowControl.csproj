<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MonitorWindowControl</AssemblyName>
    <RootNamespace>MonitorWindowControl</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Monitor Window Control</Product>
    <AssemblyTitle>Monitor Window Control</AssemblyTitle>
    <Description>Opens each app's windows on the monitor you actually use it on.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Single-file publish: pack native WPF DLLs into the exe too. Not compressed on purpose:
         compression makes the exe smaller but unpacks everything into RAM (~370 MB vs much less). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- WinForms is only used for the tray icon; DPI is set by app.manifest on purpose. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
