<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MonitorWindowControl</AssemblyName>
    <RootNamespace>MonitorWindowControl</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.4.1</Version>
    <!-- Uses the installed .NET Desktop Runtime (8, or any newer one: 9, 10, ...) instead of bundling
         its own copy, which keeps the exe at ~6 MB instead of ~144 MB. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RollForward>Major</RollForward>
    <Product>Monitor Window Control</Product>
    <AssemblyTitle>Monitor Window Control</AssemblyTitle>
    <Description>Opens each app's windows on the monitor you actually use it on.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- WinForms is only used for the tray icon; DPI is set by app.manifest on purpose. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <!-- The tiny native helper, packed inside so there's still one file to download. Built first by build.ps1. -->
    <EmbeddedResource Include="..\MonitorWindowControlHelper\bin\publish\MonitorWindowControlHelper.exe" LogicalName="helper.exe"
                      Condition="Exists('..\MonitorWindowControlHelper\bin\publish\MonitorWindowControlHelper.exe')" />
  </ItemGroup>

</Project>
